.*
!.gitattributes
!.gitignore
*.py[cod]
__pycache__/
.smart-env/
log/

# Recorded captain's log entries (README §11).  Personal dictation, written
# beside the code by default — this keeps a stray `git add -A` from
# publishing it.  Point SDK_CAPTAINSLOG_FILE outside the repo if you would
# rather it never land here at all.
captainslog.txt

# Onboarding setting (multiuser/PI.md phase 2): per installation, written by the
# listener when "computer, secure transceiver" is heard. Never committed.
onboarding_disabled.flag
# Transceiver health sentence (phase 2): runtime state, never committed.
health.txt
health.txt.tmp
